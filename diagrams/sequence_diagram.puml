@startuml Haptic Stage Navigation System — Sequence Diagram

!theme plain

skinparam sequence {
  ArrowColor #3b5bdb
  ActorBorderColor #3b5bdb
  LifeLineBorderColor #3b5bdb
  LifeLineBackgroundColor #f0f4ff
  ParticipantBackgroundColor #f0f4ff
  ParticipantBorderColor #3b5bdb
  BoxBackgroundColor #f8f9fa
  BoxBorderColor #adb5bd
  NoteBackgroundColor #fff9db
  NoteBorderColor #f59f00
  FontName Arial
}

skinparam shadowing false

title Haptic Stage Navigation System — Runtime Sequence

' ─────────────────────────────────────────
' PARTICIPANTS
' ─────────────────────────────────────────

box "Anchor [A, B, C, E]" #e8f4fd
  participant "«UWB anchor»\nDWM3001CDK" as DWM_anchor
  participant "«systemd service»\nuwb-agent\n(main.py)" as UWBagent
end box

box "Anchor D — Hub" #edf2ff
  participant "«UWB anchor»\nDWM3001CDK" as AnchorD
  participant "«systemd service»\nuwb-agent\n(main.py)" as agentD
  participant "«systemd service»\nuwb-hub\n(hub.py)" as UWBhub
  participant "«systemd service»\nuwb-localize\n(localize.py)" as UWBlocalize
  participant "«systemd service»\nuwb-server\n(pose_server.py)" as UWBserver
end box

box "Stage-Support Laptop" #f3fdf3
  participant "Stage-Support" as Laptop
end box

box "Wearable Device" #fff9db
  participant "«systemd service»\nuwb_wearable_pi\n(main.py)" as WearableApp
  participant "«systemd service»\nhaptic-hearing\nserver.py (:8000)" as WSserver
  participant "amplitude_array\n(queue)" as AmpQueue
  participant "audio_callback()\nsounddevice" as AudioCB
  participant "«pcm.multi16»\nALSA Virtual\nDevice 16ch" as ALSA
end box

box "Wearable Hardware" #fdf0f0
  participant "HapticHearing PCB #1\n«custom motor driver»\n(ch 0–7)" as PCB1
  participant "HapticHearing PCB #2\n«custom motor driver»\n(ch 8–15)" as PCB2
  participant "«LRA» VG1040003D\nMotors 0–7" as LRA1
  participant "«LRA» VG1040003D\nMotors 8–15" as LRA2
end box


' ─────────────────────────────────────────
' 1. SYSTEM STARTUP
' ─────────────────────────────────────────
== System Startup ==

AnchorD -> agentD : USB-OTG\nranging data
DWM_anchor -> UWBagent : USB-OTG\nranging data

agentD -> UWBhub : ZeroMQ CONNECT\ntcp://<pi-D>:5556
UWBagent -> UWBhub : ZeroMQ CONNECT\ntcp://<pi-D>:5556

note right of UWBhub
  All anchor agents
  connect to hub
  on startup
end note

UWBserver -> Laptop : ZeroMQ PUB available\ntcp://<pi-D>:5561 (pose)\ntcp://<pi-D>:5571 (sensors)
Laptop -> UWBserver : ZeroMQ SUB CONNECT\ntcp://<pi-D>:5561\ntcp://<pi-D>:5571

WSserver -> WSserver : bind 0.0.0.0:8000\nawait connections

Laptop -> WSserver : WebSocket CONNECT\nws://<wearable-pi>:8000
WSserver --> Laptop : 101 Switching Protocols\n(connection established)

WearableApp -> UWBserver : ZeroMQ PUB CONNECT\ntcp://<pi-D>:5572\ntopic: sensors

' ─────────────────────────────────────────
' 2. UWB RANGING PIPELINE
' ─────────────────────────────────────────
== UWB Ranging Pipeline (continuous, ~33 Hz) ==

loop every ~30 ms

  DWM_anchor -> UWBagent : USB-OTG\n{anchor_id, range_m, quality}
  AnchorD -> agentD : USB-OTG\n{anchor_id, range_m, quality}

  UWBagent -> UWBhub : ZeroMQ PUB\ntcp://<pi-D>:5556\ntopic: meas\n{tag_id, anchor_id, range_m}
  agentD -> UWBhub : ZeroMQ PUB\ntcp://<pi-D>:5556\ntopic: meas\n{tag_id, anchor_id, range_m}

  UWBhub -> UWBlocalize : ZeroMQ PUB\ntcp://<pi-D>:5560\ntopic: meas\n(aggregated ranges)

  UWBlocalize -> UWBlocalize : multilateration\n{range_A, range_B,\nrange_C, range_D, range_E}\n→ {x, y}

  UWBlocalize -> UWBserver : ZeroMQ PUB\ntcp://<pi-D>:5561\ntopic: pose\n{x, y, θ, t}

  UWBserver -> Laptop : ZeroMQ PUB\ntcp://<pi-D>:5561\ntopic: pose\n{x, y, θ, t}

end

' ─────────────────────────────────────────
' 3. IMU PUBLISHING PIPELINE
' ─────────────────────────────────────────
== IMU Publishing Pipeline (continuous, ~20 Hz) ==

loop every ~50 ms

  WearableApp -> WearableApp : BNO085 I2C read\n{orientation, accel,\ngyro, stability}

  WearableApp -> UWBserver : ZeroMQ PUB\ntcp://<pi-D>:5572\ntopic: sensors\n{orientation, accel, gyro,\nstep, stability}

  UWBserver -> Laptop : ZeroMQ PUB\ntcp://<pi-D>:5571\ntopic: sensors\n{orientation, accel, gyro}

end

' ─────────────────────────────────────────
' 4. HAPTIC CUE GENERATION & TRANSMISSION
' ─────────────────────────────────────────
== Haptic Cue Generation and Transmission (event-driven) ==

Laptop -> Laptop : process pose data\ngenerate haptic cues

loop for each PatternFrame in HapticPattern

  Laptop -> WSserver : WebSocket\nJSON frame:\n{amplitudes: [a0..a15],\nduration: ms,\ntimestamp: epoch,\ndevice: "belt"}

  WSserver -> WSserver : parse JSON\nduration_frames =\nduration × 48000 / 1000

  WSserver -> AmpQueue : enqueue\n[duration_frames,\na0, a1, ..., a15]

end

' ─────────────────────────────────────────
' 5. AUDIO OUTPUT PIPELINE
' ─────────────────────────────────────────
== Audio Output Pipeline (continuous, 48000 Hz) ==

loop sounddevice OutputStream callback

  AudioCB -> AmpQueue : dequeue next\namplitude frame

  AudioCB -> AudioCB : generate sine wave block\nper channel:\noutdata[t, ch] =\nsin(phase × Δφ) × amp[ch]

  AudioCB -> ALSA : sounddevice write\n16ch PCM\n(48000 Hz, S16_LE)

  ALSA -> PCB1 : hw:ICUSBAUDIO7D\nUSB audio\n(ch 0–7)
  ALSA -> PCB2 : hw:ICUSBAUDIO7D_1\nUSB audio\n(ch 8–15)

  PCB1 -> LRA1 : analog drive signal\n(8 channels)
  PCB2 -> LRA2 : analog drive signal\n(8 channels)

  LRA1 -> LRA1 : vibrotactile\nactuation
  LRA2 -> LRA2 : vibrotactile\nactuation

end

' ─────────────────────────────────────────
' 6. PERFORMER BUTTON PRESS
' ─────────────────────────────────────────
== Performer Button Press (event-driven) ==

WearableApp -> WearableApp : GPIO17 interrupt\n(button pulled low)

WearableApp -> UWBserver : ZeroMQ PUB\ntcp://<pi-D>:5572\ntopic: sensors\n{button: true,\ntimestamp: epoch}

UWBserver -> Laptop : ZeroMQ PUB\ntcp://<pi-D>:5571\ntopic: sensors\n{button: true}

Laptop -> Laptop : handle button event

@enduml