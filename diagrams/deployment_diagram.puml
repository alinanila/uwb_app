@startuml Haptic Stage Navigation System

!theme plain
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 80

skinparam node {
  BackgroundColor #f0f4ff
  BorderColor #3b5bdb
  FontStyle bold
}

skinparam component {
  BackgroundColor #ffffff
  BorderColor #5c7cfa
}

skinparam database {
  BackgroundColor #fff9db
  BorderColor #f59f00
}

skinparam interface {
  BackgroundColor #ebfbee
  BorderColor #2f9e44
}

skinparam rectangle {
  BackgroundColor #f4f0ff
  BorderColor #8B5CFA
  FontStyle bold
}


title Haptic Stage Navigation System — Deployment Architecture




' ─────────────────────────────────────────
' ANCHORS
' ─────────────────────────────────────────
rectangle "Static Components" as anchors #line.dashed{
  ' ─────────────────────────────────────────
  ' UWB ANCHOR LAYER
  ' ─────────────────────────────────────────
  node "Anchor [A, B, C, E]" as Anchors {
    component "<<UWB anchor>>\nDWM3001CDK" as Anchor
    component "<<Raspberry Pi Zero 2 W>>\nuwb_app" as UWBagent{
      component "<<systemd service>>\nuwb-agent\n(main.py)" as agent
    }
    component "Power Bank" as AnchorPower

    Anchor --> UWBagent : USB-OTG\nranging data
    AnchorPower --> UWBagent : USB-C\n5V
  }

  ' ─────────────────────────────────────────
  ' HUB PI
  ' ─────────────────────────────────────────
  node "Anchor D" as HubPi {
    component "<<UWB anchor>>\nDWM3001CDK" as AnchorD
    component "<<Raspberry Pi Zero 2 W>>\nuwb_app" as UWBagentD {
      component "<<systemd service>>\nuwb-agent\n(main.py)" as agentD
      component "<<systemd service>>\nuwb-hub\n(hub.py)" as UWBhub
      component "<<systemd service>>\nuwb-localize\n(localize.py)" as UWBlocalize
      component "<<systemd service>>\nuwb-server\n(pose_server.py)" as UWBserver{
        component "<<HTML web page>>\nAnchors {x,y}\nPose {x,y}\nIMU data {orientation, accel, gyro}\nFilter type" as webpage
        interface "ZeroMQ PUB/SUB\ntcp://<pi-D>:5561\ntopic:pose" as TCPpose
        interface "ZeroMQ PUB/SUB\ntcp://<pi-D>:5571\ntopic:sensors" as TCPsensors
      }
    }
    component "Power Bank" as AnchorPowerD
    
    AnchorPowerD --> UWBagentD : USB-C\n5V
    AnchorD --> UWBagentD : USB-OTG\nranging data
    agentD --> UWBhub : ZeroMQ PUB/SUB\ntcp://<pi-D>:5556\ntopic:meas
    agent --> UWBhub : ZeroMQ PUB/SUB\ntcp://<pi-D>:5556\ntopic:meas
    UWBhub --> UWBlocalize : ZeroMQ PUB/SUB\ntcp://<pi-D>:5560\ntopic:meas
    UWBlocalize --> TCP : ZeroMQ PUB/SUB\ntcp://<pi-D>:5561\ntopic:pose
  }
}




' ─────────────────────────────────────────
' STAGE-SUPPORT
' ─────────────────────────────────────────
rectangle " " as SS #line.dashed {
  node "Stage-Support\n" as Laptop {

  }
}




' ─────────────────────────────────────────
' BELT
' ─────────────────────────────────────────
rectangle "Wearable Components" as belt #line.dashed {
  node "Wearable Device" as Wearable {

    component "<<Raspberry Pi Zero 2 W>>" as WearablePi{
      component "haptic-hearing\nserver.py" as ServerPy {
        component "WebSocket\nhandler\n:8000" as WShandler
        component "audio_callback()\nsine wave gen" as AudioCB
        component "Flask /data\n:5000" as Flask
        database "amplitude_array\n(queue)" as AmpQueue
      }

      component "uwb_wearable_pi\nmain.py" as WearableApp {
        component "bno085.py\n(I2C reader)" as BNO
        component "publisher.py\n(ZeroMQ PUB)" as ZMQwearPub
        component "button.py\n(GPIO)" as Button
      }

      component "«pcm.multi16»\nALSA Virtual Device\n16-channel" as ALSA {
        component "hw:ICUSBAUDIO7D\n(channels 0–7)" as Card1
        component "hw:ICUSBAUDIO7D_1\n(channels 8–15)" as Card2
      }
    }

    component "HapticHearing PCB\n(custom motor drivers)" as PCB1
    component "HapticHearing PCB\n(custom motor drivers)" as PCB2
    component "<<LRA>>\nVG1040003D\nMotors 0–7\n" as LRA1
    component "<<LRA>>\nVG1040003D\nMotors 8–15\n" as LRA2
    component "<<I2C sensor>>\nBNO085 IMU" as IMU
    component "«UWB Tag»\nDWM3001CDK" as Tag
    component "<<USB Hub>>\n4-Port USB Hub pHAT" as USBhub
    component "Power Bank" as PowerBank

    PowerBank --> WearablePi : micro-USB\n5V
    WearablePi --> USBhub : micro-USB shim\nUSB expander
    Card1 --> USBhub : ALSA hw write\n(channels 0–7)
    Card2 --> USBhub : ALSA hw write\n(channels 8–15)
    USBhub --> PCB1 : USB\ndata (hw write 0-7)\n power
    USBhub --> PCB2 : USB\ndata (hw write 8-15)\n power
    USBhub --> Tag : micro-USB\npower only
    PCB1 --> LRA1 : analog audio\n(8 channels)
    PCB2 --> LRA2 : analog audio\n(8 channels)
    IMU --> WearablePi : I2C\n(GPIO 2/3)
    WShandler --> AmpQueue : enqueue\namplitude frames
    AmpQueue --> AudioCB : dequeue\nper callback
    AudioCB --> ALSA : sounddevice\nOutputStream\n(48000 Hz, 16ch)
    Flask --> AmpQueue : read log\nwindow

    BNO --> ZMQwearPub : IMU data\n{orientation,\naccel, gyro}
    Button --> ZMQwearPub : button\nevents
  }
}




' ─────────────────────────────────────────
' NODE CONNECTIONS
' ─────────────────────────────────────────
interface "UWB DS-TWR" as UWB 
interface "JSON frames\n{amplitudes[16],\nduration,\ntimestamp,\ndevice}" as JSON

Tag <--> UWB
UWB <--> Anchor
UWB <--> AnchorD

TCPpose --> webpage
TCPsensors --> webpage
TCPpose --> Laptop
TCPsensors --> Laptop

ZMQwearPub --> TCPsensors

Laptop --> JSON
JSON --> WShandler




@enduml